---
import Layout from "../layouts/Layout.astro";
import Pagination from "../components/Pagination.astro";
import type { ShortPageData } from "../shared/type";
import config from "urodele.config";

interface Props {
  posts: ShortPageData[];
  page: number;
  pages: number;
}

const { posts, page, pages } = Astro.props;
---

<script>
  import { mount } from "../components/RelativeTime";
  mount("data-acc-time");
</script>

<Layout title={config.head.title}>
  <div class="hero">
    <h1>{config.head.brand}</h1>
    <p>{config.head.description}</p>
  </div>

  <main>
    <div class="post-list">
      {
        posts.map((item, index) => (
          <a href={`/post/${item.id}`} class="card">
            <div class="card-index">
              {String(index + 1).padStart(2, '0')}
            </div>
            <div class="card-content">
              <div class="card-tags">
                {item.tags.map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
              <div class="card-title">{item.title}</div>
              <div class="card-desc">{item.intro}</div>
              <div class="card-footer">
                <span class="card-date" data-acc-time={item.createTime} />
              </div>
            </div>
          </a>
        ))
      }
    </div>
    <div class="pagination-wrapper">
      <Pagination page={page} pages={pages} />
    </div>
  </main>
</Layout>

<style>
  /* ===== 强制覆盖全局样式 ===== */
  :global(body) {
    background: #f5f2eb !important;
    font-family: Georgia, "Songti SC", "STSong", serif !important;
    color: #1a1a1a !important;
  }

  /* ===== 顶部标题区 ===== */
  .hero {
    max-width: 900px !important;
    margin: 0 auto !important;
    padding: 100px 20px 60px !important;
    text-align: center !important;
  }
  .hero h1 {
    font-family: Georgia, "Songti SC", "STSong", serif !important;
    font-size: 52px !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
    margin-bottom: 20px !important;
    color: #1a1a1a !important;
    letter-spacing: -0.03em !important;
  }
  .hero p {
    font-family: Georgia, "Songti SC", "STSong", serif !important;
    font-size: 14px !important;
    color: #888 !important;
    letter-spacing: 0.3em !important;
    text-transform: uppercase !important;
  }

  /* ===== 文章列表容器 ===== */
  .post-list {
    max-width: 800px !important;
    margin: 0 auto !important;
    padding: 40px 24px 0 !important;
  }

  /* ===== 卡片 ===== */
  .card {
    display: flex !important;
    gap: 32px !important;
    align-items: flex-start !important;
    padding: 36px 0 !important;
    border-bottom: 1px solid #ddd8ce !important;
    text-decoration: none !important;
    color: inherit !important;
    transition: all 0.3s ease !important;
    cursor: pointer !important;
  }
  .card:last-child {
    border-bottom: none !important;
  }
  .card:hover {
    padding-left: 16px !important;
  }
  .card:hover .card-title {
    color: #b45309 !important;
  }

  .card-index {
    font-size: 14px !important;
    color: #b45309 !important;
    font-weight: 700 !important;
    font-family: Georgia, serif !important;
    padding-top: 6px !important;
    min-width: 40px !important;
    flex-shrink: 0 !important;
  }

  .card-content {
    flex: 1 !important;
  }

  .card-tags {
    display: flex !important;
    gap: 8px !important;
    margin-bottom: 12px !important;
    flex-wrap: wrap !important;
  }
  .tag {
    font-size: 11px !important;
    font-weight: 600 !important;
    color: #92400e !important;
    background: #fef3c7 !important;
    padding: 3px 10px !important;
    border-radius: 4px !important;
    text-decoration: none !important;
  }

  .card-title {
    font-family: Georgia, "Songti SC", "STSong", serif !important;
    font-size: 26px !important;
    font-weight: 700 !important;
    line-height: 1.35 !important;
    margin-bottom: 12px !important;
    color: #1a1a1a !important;
    transition: color 0.2s !important;
  }

  .card-desc {
    font-size: 15px !important;
    color: #666 !important;
    line-height: 1.8 !important;
    margin-bottom: 16px !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
  }

  .card-footer {
    font-size: 12px !important;
    color: #999 !important;
    letter-spacing: 0.05em !important;
  }
  .card-footer .card-date::before {
    content: "📅";
    font-size: 12px;
    margin-right: 4px;
    opacity: 0.7;
  }

  /* ===== 分页 ===== */
  .pagination-wrapper {
    max-width: 800px !important;
    margin: 0 auto !important;
    padding: 0 24px 80px !important;
  }

  /* ===== 移动端适配 ===== */
  @media (max-width: 640px) {
    .hero {
      padding: 60px 16px 40px !important;
    }
    .hero h1 {
      font-size: 32px !important;
    }
    .post-list {
      padding: 24px 16px 0 !important;
    }
    .card {
      gap: 16px !important;
      padding: 28px 0 !important;
    }
    .card-index {
      font-size: 12px !important;
      min-width: 28px !important;
    }
    .card-title {
      font-size: 20px !important;
    }
    .pagination-wrapper {
      padding: 0 16px 60px !important;
    }
  }
</style>
