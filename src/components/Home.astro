---
import Layout from "../layouts/Layout.astro";
import Pagination from "../components/Pagination.astro";
import type { ShortPageData } from "../shared/type";
import config from "urodele.config";

interface Props {
  posts: ShortPageData[];
  page: number;
  pages: number;
}

const { posts, page, pages } = Astro.props;
---

<script>
  import { mount } from "../components/RelativeTime";
  mount("data-acc-time");
</script>

<Layout title={config.head.title}>
  <!-- 顶部标题区：替换原来的黑块，改为浅色渐变 -->
  <div class="hero-header">
    <h1 class="brand-title">{config.head.brand}</h1>
    <div class="title-line"></div>
    <p class="brand-desc">{config.head.description}</p>
  </div>

  <main>
    <div class="content-wrapper">
      {
        posts.map((item) => (
          <div class="post-card group">
            <a href={`/post/${item.id}`} class="card-link">
              <div class="card-text">
                <h2 class="post-title">{item.title}</h2>
                <p class="post-intro">{item.intro}</p>
              </div>
              {item.cover && (
                <img class="post-cover" src={item.cover.src} alt={item.cover.alt} />
              )}
            </a>
            
            <div class="card-meta">
              <div class="tag-list">
                {item.tags.map((tag) => (
                  <a href={`/tag/${encodeURIComponent(tag)}`} class="tag-pill">
                    #{tag}
                  </a>
                ))}
              </div>
              <div data-acc-time={item.createTime} class="post-date" />
            </div>
          </div>
        ))
      }
      <Pagination page={page} pages={pages} />
    </div>
  </main>
</Layout>

<style>
  /* ===== 顶部标题区 ===== */
  .hero-header {
    text-align: center;
    padding: 80px 20px 60px;
    background: #ffffff; /* 纯白背景，极简 */
    border-bottom: 1px solid #f0f0f0;
  }

  .brand-title {
    font-size: 40px;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 8px;
    letter-spacing: -0.03em;
  }

  /* 去掉那个蓝色横条，改成优雅的小字 */
  .brand-desc {
    font-size: 15px;
    color: #94a3b8;
    margin: 0;
    font-weight: 400;
  }

  /* ===== 文章列表容器 ===== */
  .content-wrapper {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  /* ===== 文章卡片样式 ===== */
  .post-card {
    background: #ffffff;
    border: 1px solid #f0f0f0;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 16px;
    transition: all 0.25s ease;
  }
  .post-card:hover {
    border-color: #e2e8f0;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
  }

  /* 卡片内部链接与布局 */
  .card-link {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    text-decoration: none;
    gap: 20px;
  }
  .card-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .post-title {
    font-size: 19px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.4;
    transition: color 0.2s;
  }
  .post-card:hover .post-title {
    color: #2563eb;
  }
  .post-intro {
    font-size: 14px;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-cover {
    width: 120px;
    height: 80px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  /* 卡片底部信息 */
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid #f8fafc;
  }
  .tag-list {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag-pill {
    background: #f1f5f9;
    color: #475569;
    font-size: 12px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .tag-pill:hover {
    background: #e2e8f0;
  }
  .post-date {
    font-size: 12px;
    color: #94a3b8;
    white-space: nowrap;
  }

  /* ===== 移动端适配 ===== */
  @media (max-width: 640px) {
    .hero-header {
      padding: 50px 16px 40px;
    }
    .brand-title {
      font-size: 30px;
    }
    .content-wrapper {
      padding: 24px 16px 60px;
    }
    .post-card {
      padding: 20px;
    }
    .card-link {
      flex-direction: column-reverse;
      gap: 12px;
    }
    .post-cover {
      width: 100%;
      height: 160px;
    }
  }
</style>
