{"content":"{\"__ud_title\":\"MTL 领域介绍\",\"__ud_tags\":[\"MTL\"],\"__ud_update_time\":1790047078978,\"__ud_create_time\":1790043284626,\"__ud_draft\":false,\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":1,\"id\":\"MTL-简介\"},\"content\":[{\"type\":\"text\",\"text\":\"MTL 领域介绍\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\"},{\"type\":\"codeBlock\",\"attrs\":{\"language\":\"html\"},\"content\":[{\"type\":\"text\",\"text\":\"<!DOCTYPE html>\\n<html lang=\\\"zh\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\">\\n  <title>粒子文字特效</title>\\n  <style>\\n    body {\\n      margin: 0;\\n      overflow: hidden;\\n      background: #0a0a0a;\\n      display: flex;\\n      justify-content: center;\\n      align-items: center;\\n      height: 100vh;\\n      font-family: 'Arial Black', sans-serif;\\n    }\\n    canvas {\\n      display: block;\\n    }\\n  </style>\\n</head>\\n<body>\\n  <canvas id=\\\"canvas\\\"></canvas>\\n  <script>\\n    const canvas = document.getElementById('canvas');\\n    const ctx = canvas.getContext('2d');\\n    let width, height;\\n    let particles = [];\\n    const text = 'MCRHUB';\\n    const particleCount = 800;\\n\\n    function resize() {\\n      width = canvas.width = window.innerWidth;\\n      height = canvas.height = window.innerHeight;\\n    }\\n\\n    class Particle {\\n      constructor(x, y, targetX, targetY) {\\n        this.x = x;\\n        this.y = y;\\n        this.targetX = targetX;\\n        this.targetY = targetY;\\n        this.vx = (Math.random() - 0.5) * 4;\\n        this.vy = (Math.random() - 0.5) * 4;\\n        this.size = Math.random() * 2 + 1;\\n        this.color = `hsl(${Math.random() * 60 + 200}, 100%, 60%)`;\\n      }\\n\\n      update() {\\n        const dx = this.targetX - this.x;\\n        const dy = this.targetY - this.y;\\n        this.vx += dx * 0.00005;\\n        this.vy += dy * 0.00005;\\n        this.vx *= 0.98;\\n        this.vy *= 0.98;\\n        this.x += this.vx;\\n        this.y += this.vy;\\n      }\\n\\n      draw() {\\n        ctx.beginPath();\\n        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);\\n        ctx.fillStyle = this.color;\\n        ctx.fill();\\n        ctx.shadowBlur = 10;\\n        ctx.shadowColor = this.color;\\n      }\\n    }\\n\\n    function init() {\\n      resize();\\n      ctx.fillStyle = '#ffffff';\\n      ctx.font = 'bold 120px Arial';\\n      ctx.textAlign = 'center';\\n      ctx.textBaseline = 'middle';\\n      const textMetrics = ctx.measureText(text);\\n      const textWidth = textMetrics.width;\\n      const textX = width / 2;\\n      const textY = height / 2;\\n\\n      const imageData = ctx.getImageData(\\n        textX - textWidth / 2,\\n        textY - 60,\\n        textWidth,\\n        120\\n      );\\n\\n      particles = [];\\n      const step = Math.floor(Math.sqrt((textWidth * 120) / particleCount));\\n      for (let y = 0; y < imageData.height; y += step) {\\n        for (let x = 0; x < imageData.width; x += step) {\\n          const index = (y * imageData.width + x) * 4;\\n          const alpha = imageData.data[index + 3];\\n          if (alpha > 128) {\\n            const targetX = textX - textWidth / 2 + x;\\n            const targetY = textY - 60 + y;\\n            particles.push(\\n              new Particle(\\n                Math.random() * width,\\n                Math.random() * height,\\n                targetX,\\n                targetY\\n              )\\n            );\\n          }\\n        }\\n      }\\n    }\\n\\n    function animate() {\\n      ctx.fillStyle = 'rgba(10, 10, 10, 0.15)';\\n      ctx.fillRect(0, 0, width, height);\\n      particles.forEach((p) => {\\n        p.update();\\n        p.draw();\\n      });\\n      requestAnimationFrame(animate);\\n    }\\n\\n    window.addEventListener('resize', init);\\n    init();\\n    animate();\\n  </script>\\n</body>\\n</html>\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"id\":\"MTL-简介\"},\"content\":[{\"type\":\"text\",\"text\":\"1、MTL 简介\"}]},{\"type\":\"blockquote\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2,\"id\":\"基本信息\"},\"content\":[{\"type\":\"text\",\"text\":\"基本信息\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"中文全称：市场到线索流程\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"英文全称：Market to Lead（市场到线索）\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"华为体系对应简称：AR（Acquisition to Revenue，获客到营收），二者本质一致，AR更偏向业务视角，MTL更偏向端到端流程视角。\"}]}]},{\"type\":\"paragraph\"},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"id\":\"核心定义\"},\"content\":[{\"type\":\"text\",\"text\":\"核心定义\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"MTL是企业客户生命周期的前端入口流程，是连接市场推广与销售转化的核心桥梁，覆盖从市场获客、多渠道线索归集、线索分层培育、线索质量筛选，到输出合格线索（MQL/SQL）并移交销售部门的完整链路，核心目标是高效获取高质量客户线索，降低获客成本，为销售转化提供稳定、优质的来源，是CRM系统中营销自动化（MA）模块的核心支撑流程。\"}]},{\"type\":\"paragraph\"},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"id\":\"核心流程\"},\"content\":[{\"type\":\"text\",\"text\":\"核心流程\"}]},{\"type\":\"orderedList\",\"attrs\":{\"start\":1,\"type\":null},\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"市场规划与投入：明确目标客户画像、营销渠道布局，制定营销预算，确定单渠道投入比例及单线索目标成本；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"多渠道获客：通过官网、表单、公众号、短视频、投放广告（SEM/信息流）、线下展会、社群引流、内容营销（白皮书/案例）、企微裂变等全渠道，获取潜在客户信息；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"线索归集与清洗：将全渠道获取的线索统一归集到CRM系统，完成线索去重、信息校验（过滤空号、无效信息），补充基础标签（行业、规模、来源渠道）；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"线索分层与培育：基于线索标签（基础标签、行为标签、意向标签）进行分层，对弱意向线索通过营销自动化（MA）工具开展培育（定时推送行业资讯、产品资料、活动邀请，触发自动化互动旅程）；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"线索质量认证：通过线索打分模型（结合互动行为、资料完整度、意向程度），筛选出符合目标客户画像、有明确需求意向的合格线索，分为MQL（营销合格线索）和SQL（销售合格线索）；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"线索移交与协同：将SQL移交销售部门跟进，同步线索培育记录、互动历史，建立市场与销售的协同机制，跟踪线索后续转化情况，及时优化营销策略。\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"id\":\"关键指标\"},\"content\":[{\"type\":\"text\",\"text\":\"关键指标\"}]},{\"type\":\"orderedList\",\"attrs\":{\"start\":1,\"type\":null},\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"获客类：总线索获取量、单渠道线索量、渠道线索占比、曝光量、点击率（CTR）、落地页跳出率、新增私域用户数；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"线索质量类：线索有效率、线索去重率、线索档案完整率、MQL生成量、SQL生成量、线索转MQL转化率、MQL转SQL转化率；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"培育运营类：线索培育覆盖率、内容触达量、内容打开率、线索互动率、沉睡线索占比、线索老化率；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"成本与效率类：单线索获取成本（CPL）、单MQL成本、营销总预算、单渠道ROI、线索平均培育周期；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"协同类：线索移交总量、线索退回率、销售首次响应及时率、线索跟进完成率。\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"id\":\"与CRM的关联\"},\"content\":[{\"type\":\"text\",\"text\":\"与CRM的关联\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"MTL是CRM系统营销模块（MA营销自动化）的核心流程，CRM系统为MTL提供全链路支撑：\"}]},{\"type\":\"orderedList\",\"attrs\":{\"start\":1,\"type\":null},\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"线索统一管理（线索池、去重、标签）；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"自动化培育（旅程配置、多渠道触达）；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"线索打分与认证（自定义打分模型）；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"数据统计与分析（渠道效果、培育效果、转化数据）；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"市场与销售协同（线索移交、跟进记录同步）。\"}]},{\"type\":\"paragraph\"}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"id\":\"常用延伸补充\"},\"content\":[{\"type\":\"text\",\"text\":\"常用延伸补充\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"MQL（Marketing Qualified Lead）：营销合格线索，由市场部认证，符合目标客户画像、有初步需求意向，可移交销售跟进的线索；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"SQL（Sales Qualified Lead）：销售合格线索，由销售部复核，确认有明确商机潜力、符合跟进标准，可进入LTC流程的线索；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"线索打分模型：MTL的核心工具，自定义打分规则（如浏览产品页面+5分、下载方案+10分、咨询客服+15分），自动区分线索质量，提升销售人效；\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"code\"}],\"text\":\"营销自动化（MA）：MTL流程的核心支撑工具，可实现线索培育、内容触达、旅程自动化，替代人工重复工作，提升培育效率。\"}]}]}]}]}","title":"MTL 领域介绍","tags":["MTL"],"updateTime":1790047078978,"createTime":1790043284626,"draft":false,"intro":"","html":"<h1 level=\"1\" id=\"MTL-领域介绍\">MTL 领域介绍</h1><p></p><p></p><div class=\"llt-code readonly\"><div class=\"language\">html</div><div class=\"wrapper\"><pre><code class=\"language-html\"><span class=\"xml\" class=\"xml\"><span class=\"hljs-meta\" class=\"hljs-meta\">&lt;!DOCTYPE <span class=\"hljs-keyword\" class=\"hljs-keyword\">html</span>&gt;</span>\n<span class=\"hljs-tag\" class=\"hljs-tag\">&lt;<span class=\"hljs-name\" class=\"hljs-name\">html</span> <span class=\"hljs-attr\" class=\"hljs-attr\">lang</span>=<span class=\"hljs-string\" class=\"hljs-string\">&quot;zh&quot;</span>&gt;</span>\n<span class=\"hljs-tag\" class=\"hljs-tag\">&lt;<span class=\"hljs-name\" class=\"hljs-name\">head</span>&gt;</span>\n  <span class=\"hljs-tag\" class=\"hljs-tag\">&lt;<span class=\"hljs-name\" class=\"hljs-name\">meta</span> <span class=\"hljs-attr\" class=\"hljs-attr\">charset</span>=<span class=\"hljs-string\" class=\"hljs-string\">&quot;UTF-8&quot;</span>&gt;</span>\n  <span class=\"hljs-tag\" class=\"hljs-tag\">&lt;<span class=\"hljs-name\" class=\"hljs-name\">title</span>&gt;</span>粒子文字特效<span class=\"hljs-tag\" class=\"hljs-tag\">&lt;/<span class=\"hljs-name\" class=\"hljs-name\">title</span>&gt;</span>\n  <span class=\"hljs-tag\" class=\"hljs-tag\">&lt;<span class=\"hljs-name\" class=\"hljs-name\">style</span>&gt;</span></span><span class=\"css\" class=\"css\">\n    <span class=\"hljs-selector-tag\" class=\"hljs-selector-tag\">body</span> {\n      <span class=\"hljs-attribute\" class=\"hljs-attribute\">margin</span>: <span class=\"hljs-number\" class=\"hljs-number\">0</span>;\n      <span class=\"hljs-attribute\" class=\"hljs-attribute\">overflow</span>: hidden;\n      <span class=\"hljs-attribute\" class=\"hljs-attribute\">background</span>: <span class=\"hljs-number\" class=\"hljs-number\">#0a0a0a</span>;\n      <span class=\"hljs-attribute\" class=\"hljs-attribute\">display</span>: flex;\n      <span class=\"hljs-attribute\" class=\"hljs-attribute\">justify-content</span>: center;\n      <span class=\"hljs-attribute\" class=\"hljs-attribute\">align-items</span>: center;\n      <span class=\"hljs-attribute\" class=\"hljs-attribute\">height</span>: <span class=\"hljs-number\" class=\"hljs-number\">100vh</span>;\n      <span class=\"hljs-attribute\" class=\"hljs-attribute\">font-family</span>: <span class=\"hljs-string\" class=\"hljs-string\">&apos;Arial Black&apos;</span>, sans-serif;\n    }\n    <span class=\"hljs-selector-tag\" class=\"hljs-selector-tag\">canvas</span> {\n      <span class=\"hljs-attribute\" class=\"hljs-attribute\">display</span>: block;\n    }\n</span><span class=\"xml\" class=\"xml\">  <span class=\"hljs-tag\" class=\"hljs-tag\">&lt;/<span class=\"hljs-name\" class=\"hljs-name\">style</span>&gt;</span>\n<span class=\"hljs-tag\" class=\"hljs-tag\">&lt;/<span class=\"hljs-name\" class=\"hljs-name\">head</span>&gt;</span>\n<span class=\"hljs-tag\" class=\"hljs-tag\">&lt;<span class=\"hljs-name\" class=\"hljs-name\">body</span>&gt;</span>\n  <span class=\"hljs-tag\" class=\"hljs-tag\">&lt;<span class=\"hljs-name\" class=\"hljs-name\">canvas</span> <span class=\"hljs-attr\" class=\"hljs-attr\">id</span>=<span class=\"hljs-string\" class=\"hljs-string\">&quot;canvas&quot;</span>&gt;</span><span class=\"hljs-tag\" class=\"hljs-tag\">&lt;/<span class=\"hljs-name\" class=\"hljs-name\">canvas</span>&gt;</span>\n  <span class=\"hljs-tag\" class=\"hljs-tag\">&lt;<span class=\"hljs-name\" class=\"hljs-name\">script</span>&gt;</span></span><span class=\"javascript\" class=\"javascript\">\n    <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> canvas = <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">document</span>.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">getElementById</span>(<span class=\"hljs-string\" class=\"hljs-string\">&apos;canvas&apos;</span>);\n    <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> ctx = canvas.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">getContext</span>(<span class=\"hljs-string\" class=\"hljs-string\">&apos;2d&apos;</span>);\n    <span class=\"hljs-keyword\" class=\"hljs-keyword\">let</span> width, height;\n    <span class=\"hljs-keyword\" class=\"hljs-keyword\">let</span> particles = [];\n    <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> text = <span class=\"hljs-string\" class=\"hljs-string\">&apos;MCRHUB&apos;</span>;\n    <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> particleCount = <span class=\"hljs-number\" class=\"hljs-number\">800</span>;\n\n    <span class=\"hljs-keyword\" class=\"hljs-keyword\">function</span> <span class=\"hljs-title,function_\" class=\"hljs-title,function_\">resize</span>(<span class=\"hljs-params\" class=\"hljs-params\"></span>) {\n      width = canvas.<span class=\"hljs-property\" class=\"hljs-property\">width</span> = <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">window</span>.<span class=\"hljs-property\" class=\"hljs-property\">innerWidth</span>;\n      height = canvas.<span class=\"hljs-property\" class=\"hljs-property\">height</span> = <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">window</span>.<span class=\"hljs-property\" class=\"hljs-property\">innerHeight</span>;\n    }\n\n    <span class=\"hljs-keyword\" class=\"hljs-keyword\">class</span> <span class=\"hljs-title,class_\" class=\"hljs-title,class_\">Particle</span> {\n      <span class=\"hljs-title,function_\" class=\"hljs-title,function_\">constructor</span>(<span class=\"hljs-params\" class=\"hljs-params\">x, y, targetX, targetY</span>) {\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">x</span> = x;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">y</span> = y;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">targetX</span> = targetX;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">targetY</span> = targetY;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">vx</span> = (<span class=\"hljs-title,class_\" class=\"hljs-title,class_\">Math</span>.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">random</span>() - <span class=\"hljs-number\" class=\"hljs-number\">0.5</span>) * <span class=\"hljs-number\" class=\"hljs-number\">4</span>;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">vy</span> = (<span class=\"hljs-title,class_\" class=\"hljs-title,class_\">Math</span>.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">random</span>() - <span class=\"hljs-number\" class=\"hljs-number\">0.5</span>) * <span class=\"hljs-number\" class=\"hljs-number\">4</span>;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">size</span> = <span class=\"hljs-title,class_\" class=\"hljs-title,class_\">Math</span>.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">random</span>() * <span class=\"hljs-number\" class=\"hljs-number\">2</span> + <span class=\"hljs-number\" class=\"hljs-number\">1</span>;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">color</span> = <span class=\"hljs-string\" class=\"hljs-string\">`hsl(<span class=\"hljs-subst\" class=\"hljs-subst\">${<span class=\"hljs-built_in\" class=\"hljs-built_in\">Math</span>.random() * <span class=\"hljs-number\" class=\"hljs-number\">60</span> + <span class=\"hljs-number\" class=\"hljs-number\">200</span>}</span>, 100%, 60%)`</span>;\n      }\n\n      <span class=\"hljs-title,function_\" class=\"hljs-title,function_\">update</span>(<span class=\"hljs-params\" class=\"hljs-params\"></span>) {\n        <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> dx = <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">targetX</span> - <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">x</span>;\n        <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> dy = <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">targetY</span> - <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">y</span>;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">vx</span> += dx * <span class=\"hljs-number\" class=\"hljs-number\">0.00005</span>;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">vy</span> += dy * <span class=\"hljs-number\" class=\"hljs-number\">0.00005</span>;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">vx</span> *= <span class=\"hljs-number\" class=\"hljs-number\">0.98</span>;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">vy</span> *= <span class=\"hljs-number\" class=\"hljs-number\">0.98</span>;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">x</span> += <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">vx</span>;\n        <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">y</span> += <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">vy</span>;\n      }\n\n      <span class=\"hljs-title,function_\" class=\"hljs-title,function_\">draw</span>(<span class=\"hljs-params\" class=\"hljs-params\"></span>) {\n        ctx.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">beginPath</span>();\n        ctx.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">arc</span>(<span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">x</span>, <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">y</span>, <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">size</span>, <span class=\"hljs-number\" class=\"hljs-number\">0</span>, <span class=\"hljs-title,class_\" class=\"hljs-title,class_\">Math</span>.<span class=\"hljs-property\" class=\"hljs-property\">PI</span> * <span class=\"hljs-number\" class=\"hljs-number\">2</span>);\n        ctx.<span class=\"hljs-property\" class=\"hljs-property\">fillStyle</span> = <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">color</span>;\n        ctx.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">fill</span>();\n        ctx.<span class=\"hljs-property\" class=\"hljs-property\">shadowBlur</span> = <span class=\"hljs-number\" class=\"hljs-number\">10</span>;\n        ctx.<span class=\"hljs-property\" class=\"hljs-property\">shadowColor</span> = <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">this</span>.<span class=\"hljs-property\" class=\"hljs-property\">color</span>;\n      }\n    }\n\n    <span class=\"hljs-keyword\" class=\"hljs-keyword\">function</span> <span class=\"hljs-title,function_\" class=\"hljs-title,function_\">init</span>(<span class=\"hljs-params\" class=\"hljs-params\"></span>) {\n      <span class=\"hljs-title,function_\" class=\"hljs-title,function_\">resize</span>();\n      ctx.<span class=\"hljs-property\" class=\"hljs-property\">fillStyle</span> = <span class=\"hljs-string\" class=\"hljs-string\">&apos;#ffffff&apos;</span>;\n      ctx.<span class=\"hljs-property\" class=\"hljs-property\">font</span> = <span class=\"hljs-string\" class=\"hljs-string\">&apos;bold 120px Arial&apos;</span>;\n      ctx.<span class=\"hljs-property\" class=\"hljs-property\">textAlign</span> = <span class=\"hljs-string\" class=\"hljs-string\">&apos;center&apos;</span>;\n      ctx.<span class=\"hljs-property\" class=\"hljs-property\">textBaseline</span> = <span class=\"hljs-string\" class=\"hljs-string\">&apos;middle&apos;</span>;\n      <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> textMetrics = ctx.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">measureText</span>(text);\n      <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> textWidth = textMetrics.<span class=\"hljs-property\" class=\"hljs-property\">width</span>;\n      <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> textX = width / <span class=\"hljs-number\" class=\"hljs-number\">2</span>;\n      <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> textY = height / <span class=\"hljs-number\" class=\"hljs-number\">2</span>;\n\n      <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> imageData = ctx.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">getImageData</span>(\n        textX - textWidth / <span class=\"hljs-number\" class=\"hljs-number\">2</span>,\n        textY - <span class=\"hljs-number\" class=\"hljs-number\">60</span>,\n        textWidth,\n        <span class=\"hljs-number\" class=\"hljs-number\">120</span>\n      );\n\n      particles = [];\n      <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> step = <span class=\"hljs-title,class_\" class=\"hljs-title,class_\">Math</span>.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">floor</span>(<span class=\"hljs-title,class_\" class=\"hljs-title,class_\">Math</span>.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">sqrt</span>((textWidth * <span class=\"hljs-number\" class=\"hljs-number\">120</span>) / particleCount));\n      <span class=\"hljs-keyword\" class=\"hljs-keyword\">for</span> (<span class=\"hljs-keyword\" class=\"hljs-keyword\">let</span> y = <span class=\"hljs-number\" class=\"hljs-number\">0</span>; y &lt; imageData.<span class=\"hljs-property\" class=\"hljs-property\">height</span>; y += step) {\n        <span class=\"hljs-keyword\" class=\"hljs-keyword\">for</span> (<span class=\"hljs-keyword\" class=\"hljs-keyword\">let</span> x = <span class=\"hljs-number\" class=\"hljs-number\">0</span>; x &lt; imageData.<span class=\"hljs-property\" class=\"hljs-property\">width</span>; x += step) {\n          <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> index = (y * imageData.<span class=\"hljs-property\" class=\"hljs-property\">width</span> + x) * <span class=\"hljs-number\" class=\"hljs-number\">4</span>;\n          <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> alpha = imageData.<span class=\"hljs-property\" class=\"hljs-property\">data</span>[index + <span class=\"hljs-number\" class=\"hljs-number\">3</span>];\n          <span class=\"hljs-keyword\" class=\"hljs-keyword\">if</span> (alpha &gt; <span class=\"hljs-number\" class=\"hljs-number\">128</span>) {\n            <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> targetX = textX - textWidth / <span class=\"hljs-number\" class=\"hljs-number\">2</span> + x;\n            <span class=\"hljs-keyword\" class=\"hljs-keyword\">const</span> targetY = textY - <span class=\"hljs-number\" class=\"hljs-number\">60</span> + y;\n            particles.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">push</span>(\n              <span class=\"hljs-keyword\" class=\"hljs-keyword\">new</span> <span class=\"hljs-title,class_\" class=\"hljs-title,class_\">Particle</span>(\n                <span class=\"hljs-title,class_\" class=\"hljs-title,class_\">Math</span>.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">random</span>() * width,\n                <span class=\"hljs-title,class_\" class=\"hljs-title,class_\">Math</span>.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">random</span>() * height,\n                targetX,\n                targetY\n              )\n            );\n          }\n        }\n      }\n    }\n\n    <span class=\"hljs-keyword\" class=\"hljs-keyword\">function</span> <span class=\"hljs-title,function_\" class=\"hljs-title,function_\">animate</span>(<span class=\"hljs-params\" class=\"hljs-params\"></span>) {\n      ctx.<span class=\"hljs-property\" class=\"hljs-property\">fillStyle</span> = <span class=\"hljs-string\" class=\"hljs-string\">&apos;rgba(10, 10, 10, 0.15)&apos;</span>;\n      ctx.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">fillRect</span>(<span class=\"hljs-number\" class=\"hljs-number\">0</span>, <span class=\"hljs-number\" class=\"hljs-number\">0</span>, width, height);\n      particles.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">forEach</span>(<span class=\"hljs-function\" class=\"hljs-function\">(<span class=\"hljs-params\" class=\"hljs-params\">p</span>) =&gt;</span> {\n        p.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">update</span>();\n        p.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">draw</span>();\n      });\n      <span class=\"hljs-title,function_\" class=\"hljs-title,function_\">requestAnimationFrame</span>(animate);\n    }\n\n    <span class=\"hljs-variable,language_\" class=\"hljs-variable,language_\">window</span>.<span class=\"hljs-title,function_\" class=\"hljs-title,function_\">addEventListener</span>(<span class=\"hljs-string\" class=\"hljs-string\">&apos;resize&apos;</span>, init);\n    <span class=\"hljs-title,function_\" class=\"hljs-title,function_\">init</span>();\n    <span class=\"hljs-title,function_\" class=\"hljs-title,function_\">animate</span>();\n</span><span class=\"xml\" class=\"xml\">  <span class=\"hljs-tag\" class=\"hljs-tag\">&lt;/<span class=\"hljs-name\" class=\"hljs-name\">script</span>&gt;</span>\n<span class=\"hljs-tag\" class=\"hljs-tag\">&lt;/<span class=\"hljs-name\" class=\"hljs-name\">body</span>&gt;</span>\n<span class=\"hljs-tag\" class=\"hljs-tag\">&lt;/<span class=\"hljs-name\" class=\"hljs-name\">html</span>&gt;</span></span></code></pre></div></div><h2 level=\"2\" id=\"1MTL-简介\">1、MTL 简介</h2><blockquote><h2 level=\"2\" id=\"基本信息\">基本信息</h2><p><code>中文全称：市场到线索流程</code></p><p><code>英文全称：Market to Lead（市场到线索）</code></p><p><code>华为体系对应简称：AR（Acquisition to Revenue，获客到营收），二者本质一致，AR更偏向业务视角，MTL更偏向端到端流程视角。</code></p></blockquote><p></p><h2 level=\"2\" id=\"核心定义\">核心定义</h2><p><code>MTL是企业客户生命周期的前端入口流程，是连接市场推广与销售转化的核心桥梁，覆盖从市场获客、多渠道线索归集、线索分层培育、线索质量筛选，到输出合格线索（MQL/SQL）并移交销售部门的完整链路，核心目标是高效获取高质量客户线索，降低获客成本，为销售转化提供稳定、优质的来源，是CRM系统中营销自动化（MA）模块的核心支撑流程。</code></p><p></p><h2 level=\"2\" id=\"核心流程\">核心流程</h2><ol><li><p><code>市场规划与投入：明确目标客户画像、营销渠道布局，制定营销预算，确定单渠道投入比例及单线索目标成本；</code></p></li><li><p><code>多渠道获客：通过官网、表单、公众号、短视频、投放广告（SEM/信息流）、线下展会、社群引流、内容营销（白皮书/案例）、企微裂变等全渠道，获取潜在客户信息；</code></p></li><li><p><code>线索归集与清洗：将全渠道获取的线索统一归集到CRM系统，完成线索去重、信息校验（过滤空号、无效信息），补充基础标签（行业、规模、来源渠道）；</code></p></li><li><p><code>线索分层与培育：基于线索标签（基础标签、行为标签、意向标签）进行分层，对弱意向线索通过营销自动化（MA）工具开展培育（定时推送行业资讯、产品资料、活动邀请，触发自动化互动旅程）；</code></p></li><li><p><code>线索质量认证：通过线索打分模型（结合互动行为、资料完整度、意向程度），筛选出符合目标客户画像、有明确需求意向的合格线索，分为MQL（营销合格线索）和SQL（销售合格线索）；</code></p></li><li><p><code>线索移交与协同：将SQL移交销售部门跟进，同步线索培育记录、互动历史，建立市场与销售的协同机制，跟踪线索后续转化情况，及时优化营销策略。</code></p></li></ol><p></p><h2 level=\"2\" id=\"关键指标\">关键指标</h2><ol><li><p><code>获客类：总线索获取量、单渠道线索量、渠道线索占比、曝光量、点击率（CTR）、落地页跳出率、新增私域用户数；</code></p></li><li><p><code>线索质量类：线索有效率、线索去重率、线索档案完整率、MQL生成量、SQL生成量、线索转MQL转化率、MQL转SQL转化率；</code></p></li><li><p><code>培育运营类：线索培育覆盖率、内容触达量、内容打开率、线索互动率、沉睡线索占比、线索老化率；</code></p></li><li><p><code>成本与效率类：单线索获取成本（CPL）、单MQL成本、营销总预算、单渠道ROI、线索平均培育周期；</code></p></li><li><p><code>协同类：线索移交总量、线索退回率、销售首次响应及时率、线索跟进完成率。</code></p></li></ol><p></p><h2 level=\"2\" id=\"与CRM的关联\">与CRM的关联</h2><p><code>MTL是CRM系统营销模块（MA营销自动化）的核心流程，CRM系统为MTL提供全链路支撑：</code></p><ol><li><p><code>线索统一管理（线索池、去重、标签）；</code></p></li><li><p><code>自动化培育（旅程配置、多渠道触达）；</code></p></li><li><p><code>线索打分与认证（自定义打分模型）；</code></p></li><li><p><code>数据统计与分析（渠道效果、培育效果、转化数据）；</code></p></li><li><p><code>市场与销售协同（线索移交、跟进记录同步）。</code></p><p></p></li></ol><h2 level=\"2\" id=\"常用延伸补充\">常用延伸补充</h2><ul><li><p><code>MQL（Marketing Qualified Lead）：营销合格线索，由市场部认证，符合目标客户画像、有初步需求意向，可移交销售跟进的线索；</code></p></li><li><p><code>SQL（Sales Qualified Lead）：销售合格线索，由销售部复核，确认有明确商机潜力、符合跟进标准，可进入LTC流程的线索；</code></p></li><li><p><code>线索打分模型：MTL的核心工具，自定义打分规则（如浏览产品页面+5分、下载方案+10分、咨询客服+15分），自动区分线索质量，提升销售人效；</code></p></li><li><p><code>营销自动化（MA）：MTL流程的核心支撑工具，可实现线索培育、内容触达、旅程自动化，替代人工重复工作，提升培育效率。</code></p></li></ul><script type=\"module\">const injectHtml = (root, html) => {\n  const iframe = document.createElement(\"iframe\");\n  const htmlContent = `<html><head></head><body>${html}</body></html>`;\n  iframe.style.width = \"100%\";\n  iframe.style.height = \"100%\";\n  iframe.onload = () => {\n    const doc = iframe.contentDocument || iframe.contentWindow?.document;\n    if (!doc) {\n      return;\n    }\n    doc.open();\n    doc.write(htmlContent);\n    doc.close();\n  };\n  root.replaceChildren(iframe);\n}\n  document.querySelectorAll('.playground')?.forEach(el=>{\n    const html = el.getAttribute('data-html');\n    if (html) {\n      injectHtml(el,html);\n    }\n    const indicator = document.createElement(\"div\");\n    indicator.className = \"indicator\";\n    const showCode = document.createElement(\"div\");\n    showCode.className = \"show-code\";\n    showCode.innerText = \"code\";\n    showCode.onclick = () => {\n      el.parentElement.classList.remove(\"preview-only\");\n    };\n    const showPreview = document.createElement(\"div\");\n    showPreview.className = \"show-preview\";\n    showPreview.innerText = \"preview\";\n    showPreview.onclick = () => {\n      el.parentElement.classList.add(\"preview-only\");\n    };\n    indicator.appendChild(showCode);\n    indicator.appendChild(showPreview);\n    el.parentElement.appendChild(indicator);\n    if (window.screen.width < 768) {\n      showPreview.click();\n    }\n  });</script>","id":"MTL-简介","path":"/posts/MTL-简介.json"}