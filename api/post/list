[{"title":"杂谈","tags":[],"updateTime":1790127196127,"createTime":1790127195632,"draft":false,"intro":"","id":"杂谈","path":"杂谈"},{"title":"MTL领域概述","tags":["MTL","MI","MM","DG","SCE","Sort-001"],"updateTime":1790234613128,"createTime":1790071640995,"draft":false,"intro":"MTL（Market to Lead）是企业营销体系的前端引擎，核心在于通过系统化的市场洞察、精准的客户细分与多维度的触达策略，将广泛的市场机会转化为可跟进、可培育的销售线索。它并非简单的广告投放或活动执行，而是一套覆盖市场调研、品牌传播、内容营销、数字投放、活动运营与线索评分机制的完整闭环。MTL强调以客户画像和购买旅程为基础，在不同触点传递一致且有价值的信息，从而激发潜在客户的兴趣与互动。通过市场线索打分、行为追踪与自动化培育，市场部门能够持续输出高质量、高意向的线索，为后续销售转化奠定坚实基础。简言之，MTL解决的是“让对的人在对的时间遇见对的产品”这一根本问题，是打通市场与销售协同的第一道关口。","id":"MTL领域概述","path":"MTL领域概述"},{"title":"LTC领域概述","tags":["Sort-002","ML","MO","MCE","LTC"],"updateTime":1790232948389,"createTime":1790071505343,"draft":false,"intro":"LTC（Lead to Cash）聚焦于企业营收实现的完整链路，涵盖线索分配、商机管理、报价与合同、订单执行、交付验收、开票收款等关键环节。它要求销售、法务、财务、交付等多个部门在同一流程框架下高效协同，确保每一个商机都能以可预测、可管控的方式向前推进。LTC的核心价值在于缩短销售周期、提升赢单率、降低回款风险，并通过标准化阶段与关键节点评审，让管理层清晰掌握营收漏斗的真实健康度。在实际运营中，LTC往往与CRM系统深度结合，实现从线索转化、商机推进到合同签署、回款核销的数据贯通。它不仅是销售团队的执行主线，更是企业现金流与经营质量的保障机制。可以说，LTC解决的是“如何把机会变成收入、把收入变成现金”这一终极命题。","id":"LTC领域概述","path":"LTC领域概述"},{"title":"MCR领域概述","tags":["Sort-003","MCR"],"updateTime":1790232684434,"createTime":1790071232683,"draft":false,"intro":"MCR（Manage Client Relationship）强调以客户为中心的全生命周期经营理念，覆盖客户获取、 onboarding、日常维护、价值提升、续约增购到流失预警与挽回的完整过程。它不同于传统意义上仅记录客户信息的静态管理，而是通过数据驱动的客户分层、健康度评分、互动历史追踪与满意度监测，构建动态、可操作的客户关系视图。MCR要求销售、客服、交付与产品团队共享客户洞察，在每一个关键触点上提供一致且个性化的体验，从而提升客户粘性与终身价值。良好的MCR体系能够帮助企业从“做一单生意”转向“经营一段关系”，在存量竞争中建立护城河。归根结底，MCR解决的是“如何让客户愿意持续选择你、并主动为你传播”这一战略问题，是企业实现可持续增长的核心支撑。","id":"MCR领域概述","path":"MCR领域概述"},{"title":"Togaf架构设计","tags":[],"updateTime":1790071100999,"createTime":1790071100488,"draft":false,"intro":"","id":"Togaf架构设计","path":"Togaf架构设计"},{"title":"DDD领域驱动设计","tags":[],"updateTime":1790070832875,"createTime":1790070527467,"draft":false,"intro":"","id":"DDD领域驱动设计","path":"DDD领域驱动设计"}]